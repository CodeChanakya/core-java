<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.codechanakya</groupId>
  <artifactId>pricing-rules</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>Pricing Rules and Tests</name>
  <description>CodeChanakya Core Java, Program 36: business rules with automated JUnit 5 tests.</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.4</junit.version>
  </properties>

  <dependencies>
    <!-- scope "test": on the classpath while testing, never shipped in the jar.
         junit-jupiter is a bundle: the API for writing tests, the engine that runs
         them, and the parameterized-test support used by @ParameterizedTest. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Runs the tests during `mvn test`. Older versions of this plugin cannot find JUnit 5 tests. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
    </plugins>
  </build>
</project>
